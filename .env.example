# Copy to .env and fill in. .env is gitignored - never commit real keys.
#   cp .env.example .env
#
# Not needed for Phase 1: poc_bypass.py runs entirely offline on local
# models and makes no API calls at all.
#
# First needed in Phase 2 Week 1 (from 23 Aug), when providers.py starts
# calling real models on a cache miss.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional - only if you hit HuggingFace rate limits pulling models.
# HF_TOKEN=hf_...
